{
  "name": "ticket-extraction-contract",
  "profiles": "ticket-extraction",
  "suite_repetitions": 1,
  "warmups": 0,
  "request": {
    "temperature": 0,
    "max_output_tokens": 200
  },
  "models": [
    {
      "name": "local-example",
      "provider": "mock",
      "model": "local",
      "response": "```json\n{\"product\":\"Checkout\",\"priority\":\"high\"}\n```"
    }
  ],
  "prompts": [
    {
      "name": "ticket-extraction",
      "description": "Extract the fields required by a production support workflow.",
      "system_prompt": "Return only valid JSON. Do not include Markdown.",
      "prompt": "Urgent: payments are failing in Checkout.",
      "presets": ["structured"],
      "validation": {
        "json_schema": {
          "type": "object",
          "required": ["product", "priority"],
          "properties": {
            "product": {"type": "string"},
            "priority": {"type": "string", "enum": ["high", "medium", "low"]}
          }
        },
        "allow_fenced_json": true
      },
      "validation_fixtures": [
        {"name": "fenced payload accepted by this consumer", "response": "```json\n{\"product\":\"Checkout\",\"priority\":\"high\"}\n```", "expect": "pass"},
        {"name": "raw payload accepted", "response": "{\"product\":\"Checkout\",\"priority\":\"high\"}", "expect": "pass"},
        {"name": "unknown priority rejected", "response": "{\"product\":\"Checkout\",\"priority\":\"urgent\"}", "expect": "fail"},
        {"name": "missing product rejected", "response": "{\"priority\":\"high\"}", "expect": "fail"}
      ]
    }
  ]
}

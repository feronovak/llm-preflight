{
  "name": "foundry-mai-thinking-1-support-routing",
  "prompt": "I was charged twice for the same subscription. Which support queue should handle this?",
  "validation": {
    "exact": "billing"
  },
  "validation_fixtures": [
    {
      "name": "billing accepted",
      "response": "billing",
      "expect": "pass"
    },
    {
      "name": "sales rejected",
      "response": "sales",
      "expect": "fail"
    }
  ],
  "models": [
    {
      "provider": "foundry",
      "model": "MAI-Thinking-1",
      "base_url": "https://YOUR-RESOURCE.services.ai.azure.com/openai/v1"
    }
  ],
  "repetitions": 1,
  "warmups": 0,
  "concurrency": 1,
  "timeout_seconds": 120,
  "max_requests": 1,
  "max_estimated_cost_usd": 0.5,
  "save_responses": "failures",
  "request": {
    "system_prompt": "Return only one lowercase support queue label: billing, technical, or account.",
    "max_output_tokens": 4096,
    "retry": {
      "max_attempts": 1
    }
  }
}

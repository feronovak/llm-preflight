{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.feronovak/llm-preflight",
  "title": "LLM Preflight",
  "description": "Local, cross-provider preflight checks for LLM integration changes.",
  "websiteUrl": "https://github.com/feronovak/llm-preflight/blob/main/docs/automation/mcp.md#configure-a-workspace",
  "repository": {
    "url": "https://github.com/feronovak/llm-preflight",
    "source": "github"
  },
  "version": "2.23.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "llm-preflight",
      "version": "2.23.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--workspace",
          "value": "{workspace_path}",
          "description": "Absolute path to the repository that the server may read.",
          "isRequired": true,
          "format": "filepath",
          "variables": {
            "workspace_path": {
              "description": "Absolute path to the repository that the server may read.",
              "isRequired": true,
              "format": "filepath",
              "placeholder": "/absolute/path/to/repository"
            }
          }
        }
      ]
    }
  ]
}
